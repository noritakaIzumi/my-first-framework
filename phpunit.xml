<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="test/bootstrap.php"
         colors="true" executionOrder="depends,defects" beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="default">
            <directory>test</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <report>
            <html outputDirectory="./build/coverage"/>
        </report>
    </coverage>
    <source>
        <include>
            <directory>Cmd</directory>
            <directory>Internal</directory>
        </include>
    </source>
</phpunit>
